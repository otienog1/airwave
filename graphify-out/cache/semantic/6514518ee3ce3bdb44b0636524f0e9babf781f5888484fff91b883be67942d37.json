{"nodes": [{"id": "specs_2026_05_28_security_auth_hardening_design", "label": "Security & Auth Hardening Design Spec", "file_type": "document", "source_file": "docs/superpowers/specs/2026-05-28-security-auth-hardening-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_2026_05_28_security_auth_hardening_design_token_flow", "label": "Cookie Token Flow with Silent Refresh & Rotation", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-05-28-security-auth-hardening-design.md", "source_location": "Architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cross-domain deployment requires SameSite=None; Secure cookies. Access 24h / refresh 30d; on 401 the client silently refreshes (rotation issues both new cookies) and retries once; refresh failure dispatches auth:expired. Concurrent 401s are safe because cookies overwrite idempotently. Existing localStorage sessions log out cleanly on deploy with no migration."}], "edges": [{"source": "specs_2026_05_28_security_auth_hardening_design_token_flow", "target": "plans_2026_05_28_security_auth_hardening_httponly_cookie_auth", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/superpowers/specs/2026-05-28-security-auth-hardening-design.md", "source_location": "Architecture", "weight": 1.0}, {"source": "specs_2026_05_28_security_auth_hardening_design_token_flow", "target": "plans_2026_05_28_security_auth_hardening_fetchwithrefresh", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/superpowers/specs/2026-05-28-security-auth-hardening-design.md", "source_location": "Token flow", "weight": 1.0}, {"source": "specs_2026_05_28_security_auth_hardening_design", "target": "specs_2026_05_28_security_auth_hardening_design_token_flow", "relation": "references", "confidence": "EXTRACTED", "confide